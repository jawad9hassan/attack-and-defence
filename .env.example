# Copy this file to .env and fill in real values before running a serious
# session. The defaults below are fine for local practice, but change them
# before exposing this to anyone outside your own machine.

# Shared secret between the checker and every service's flagd sidecar.
# Anyone who knows this can rewrite any service's flag directly — keep it
# out of git (it already is, via .gitignore) and out of chat logs.
FLAGD_SECRET=change-me-flagd-secret

# Shared secret between the checker and the scoreboard's /internal/* API.
CHECKER_SECRET=change-me-checker-secret

# web-notes: the admin account's password (the SQLi bypasses this anyway,
# but it's also used by anyone doing a legitimate login).
ADMIN_PASSWORD=sup3rSecretAdminPW!
